@model EmployeeLeaveManagement.ViewModels.EmployeeDashboardViewModel

@{
    ViewData["Title"] = "Employee Dashboard";
}

<div class="container-fluid">

    <div class="mb-4">
        <h2 class="fw-bold">
            Welcome, @Model.EmployeeName 👋
        </h2>

        <p class="text-muted">
            Here's an overview of your leave requests.
        </p>
    </div>

    <div class="row g-4">

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white">
                <div class="card-body">
                    <h6>Total Leaves</h6>
                    <h2>@Model.TotalLeaves</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-warning text-dark">
                <div class="card-body">
                    <h6>Pending</h6>
                    <h2>@Model.PendingLeaves</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white">
                <div class="card-body">
                    <h6>Approved</h6>
                    <h2>@Model.ApprovedLeaves</h2>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-danger text-white">
                <div class="card-body">
                    <h6>Rejected</h6>
                    <h2>@Model.RejectedLeaves</h2>
                </div>
            </div>
        </div>

    </div>

    @using EmployeeLeaveManagement.Models

    @{
        var balances = ViewBag.LeaveBalances as List<LeaveBalance>;
    }

    @if (balances != null && balances.Any())
    {
        <div class="row mt-4">

            @foreach (var item in balances)
            {
                <div class="col-md-4 mb-3">

                    <div class="card border-0 shadow-sm">

                        <div class="card-body">

                            <h5>@item.LeaveType?.LeaveName</h5>

                            <hr />

                            <p><strong>Total :</strong> @item.TotalLeaves</p>

                            <p><strong>Used :</strong> @item.UsedLeaves</p>

                            <p>
                                <strong>Remaining :</strong>

                                <span class="badge bg-success fs-6">
                                    @item.RemainingLeaves
                                </span>
                            </p>

                        </div>

                    </div>

                </div>
            }

        </div>
    }

    <div class="card shadow-sm border-0 mt-5">

        <div class="card-header bg-white">
            <h4 class="mb-0">
                Recent Leave Requests
            </h4>
        </div>

        <div class="card-body">

            @if (Model.RecentLeaves.Any())
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead class="table-light">

                            <tr>
                                <th>Leave Type</th>
                                <th>Start Date</th>
                                <th>End Date</th>
                                <th>Total Days</th>
                                <th>Status</th>
                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model.RecentLeaves)
                            {
                                <tr>

                                    <td>
                                        @item.LeaveType?.LeaveName
                                    </td>

                                    <td>
                                        @item.StartDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @item.EndDate.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @item.TotalDays
                                    </td>

                                    <td>

                                        @if (item.Status == "Pending")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Pending
                                            </span>
                                        }
                                        else if (item.Status == "Approved")
                                        {
                                            <span class="badge bg-success">
                                                Approved
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Rejected
                                            </span>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="text-center py-5">

                    <i class="bi bi-calendar-x display-4 text-secondary"></i>

                    <h5 class="mt-3">
                        No Leave Requests Found
                    </h5>

                    <p class="text-muted">
                        You haven't applied for any leave yet.
                    </p>

                    <a asp-controller="LeaveRequest"
                       asp-action="Create"
                       class="btn btn-primary">

                        Apply Leave

                    </a>

                </div>
            }

        </div>

    </div>

</div>