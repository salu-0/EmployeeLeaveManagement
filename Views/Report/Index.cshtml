@model EmployeeLeaveManagement.ViewModels.ReportDashboardViewModel

@{
    ViewData["Title"] = "Reports Dashboard";
}

<div class="container-fluid">
    <div class="mb-3 text-end">
        <a asp-action="ExportExcel" class="btn btn-success">
            <i class="bi bi-file-earmark-excel"></i> Excel
        </a>
        <a asp-action="ExportPdf" class="btn btn-danger ms-2">
            <i class="bi bi-file-earmark-pdf"></i> Export PDF
        </a>
        <a href="#" class="btn btn-secondary ms-2">
            <i class="bi bi-printer"></i> Print
        </a>
    </div>

    <div class="card shadow-sm mb-4">
        <div class="card-body">

            <form asp-action="Index" method="get">

                <div class="row align-items-end">

                    <div class="col-md-4">
                        <label class="form-label">From Date</label>
                        <input type="date"
                               name="fromDate"
                               value="@ViewBag.FromDate"
                               class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <label class="form-label">To Date</label>
                        <input type="date"
                               name="toDate"
                               value="@ViewBag.ToDate"
                               class="form-control" />
                    </div>

                    <div class="col-md-4">
                        <button type="submit"
                                class="btn btn-primary">
                            <i class="bi bi-funnel"></i>
                            Generate Report
                        </button>

                        <a asp-action="Index"
                           class="btn btn-secondary">
                            Reset
                        </a>
                    </div>

                </div>

            </form>

        </div>
    </div>

    <!-- SMALL SUMMARY CARDS -->
    <div class="row g-3">

        <div class="col-lg-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body text-center py-3">
                    <i class="bi bi-people fs-2"></i>
                    <div class="small mt-2">Employees</div>
                    <h3 class="fw-bold mb-0">@Model.TotalEmployees</h3>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm bg-info text-white h-100">
                <div class="card-body text-center py-3">
                    <i class="bi bi-file-earmark-text fs-2"></i>
                    <div class="small mt-2">Requests</div>
                    <h3 class="fw-bold mb-0">@Model.TotalLeaveRequests</h3>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body text-center py-3">
                    <i class="bi bi-check-circle fs-2"></i>
                    <div class="small mt-2">Approved</div>
                    <h3 class="fw-bold mb-0">@Model.ApprovedLeaves</h3>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm bg-warning h-100">
                <div class="card-body text-center py-3">
                    <i class="bi bi-hourglass-split fs-2"></i>
                    <div class="small mt-2">Pending</div>
                    <h3 class="fw-bold mb-0">@Model.PendingLeaves</h3>
                </div>
            </div>
        </div>

        <div class="col-lg-2 col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm bg-danger text-white h-100">
                <div class="card-body text-center py-3">
                    <i class="bi bi-x-circle fs-2"></i>
                    <div class="small mt-2">Rejected</div>
                    <h3 class="fw-bold mb-0">@Model.RejectedLeaves</h3>
                </div>
            </div>
        </div>

    </div>

    <!-- CHARTS -->
    <div class="row mt-4 g-4">

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Leave Status Distribution</h5>
                </div>
                <div class="card-body">
                    <canvas id="statusChart" height="260"></canvas>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white">
                    <h5 class="mb-0">Monthly Leave Requests</h5>
                </div>
                <div class="card-body">
                    <canvas id="monthlyChart" height="260"></canvas>
                </div>
            </div>
        </div>

    </div>

    <!-- DEPARTMENT REPORT -->
    <div class="card shadow-sm border-0 mt-4">
        <div class="card-header bg-white">
            <h5 class="mb-0">Department Report</h5>
        </div>

        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Department</th>
                            <th class="text-end">Total Employees</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var d in ViewBag.DepartmentReport)
                        {
                            <tr>
                                <td>@d.Name</td>
                                <td class="text-end">
                                    <span class="badge bg-primary">
                                        @d.Count
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">
                <i class="bi bi-trophy"></i>
                Top Employees Taking Leave
            </h5>
        </div>

        <div class="card-body p-0">

            <div class="table-responsive">

                <table class="table table-hover align-middle mb-0">

                    <thead class="table-light">

                        <tr>
                            <th>#</th>
                            <th>Employee</th>
                            <th>Total Requests</th>
                            <th class="text-end">Total Leave Days</th>
                        </tr>

                    </thead>

                    <tbody>

                        @{
                            int i = 1;
                        }

                        @foreach (var item in ViewBag.TopEmployees)
                        {
                            <tr>
                                <td>@i</td>
                                <td>@item.Employee</td>
                                <td>@item.Requests</td>
                                <td class="text-end">
                                    <span class="badge bg-success fs-6">
                                        @item.TotalDays Days
                                    </span>
                                </td>
                            </tr>
                            i++;
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

    <!-- RECENT LEAVE REQUESTS -->
    <div class="card shadow-sm border-0 mt-4">

        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Recent Leave Requests</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">

                <table id="reportTable" class="table table-hover align-middle">

                    <thead class="table-light">
                        <tr>
                            <th>Employee</th>
                            <th>Leave Type</th>
                            <th>Days</th>
                            <th>Status</th>
                            <th>Applied Date</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.RecentRequests)
                        {
                            <tr>
                                <td>
                                    @item.Employee?.FirstName @item.Employee?.LastName
                                </td>

                                <td>
                                    @item.LeaveType?.LeaveName
                                </td>

                                <td>
                                    @item.TotalDays
                                </td>

                                <td>
                                    @if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">Pending</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">Rejected</span>
                                    }
                                </td>

                                <td>
                                    @item.AppliedDate.ToString("dd MMM yyyy")
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>

@section Scripts{
    <script>
        new Chart(document.getElementById('statusChart'),{
            type:'pie',
            data:{
                labels:['Approved','Pending','Rejected'],
                datasets:[{
                    data:[
                        @Model.ApprovedLeaves,
                        @Model.PendingLeaves,
                        @Model.RejectedLeaves
                    ]
                }]
            }
        });

        new Chart(document.getElementById('monthlyChart'),{
            type:'bar',
            data:{
                labels:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.Months)),
                datasets:[{
                    label:'Leave Requests',
                    data:@Html.Raw(System.Text.Json.JsonSerializer.Serialize(ViewBag.MonthlyRequests))
                }]
            }
        });

        $(document).ready(function(){
            $('#reportTable').DataTable({
                responsive:true,
                pageLength:5,
                lengthChange:false
            });
        });
    </script>
}