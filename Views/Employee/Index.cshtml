@model IEnumerable<EmployeeLeaveManagement.Models.Employee>

@{
    ViewData["Title"] = "Employees";
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">

        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-people-fill text-primary"></i>
                Employees
            </h3>

            <small class="text-muted">
                Manage employee information
            </small>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i>
            Add Employee
        </a>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table id="employeeTable" class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Name</th>

                        <th>Email</th>

                        <th>Phone</th>

                        <th>Department</th>

                        <th>Designation</th>

                        <th>Status</th>

                        <th class="text-center">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.FirstName @item.LastName
                                </td>

                                <td>@item.Email</td>

                                <td>@item.PhoneNumber</td>

                                <td>@item.Department?.DepartmentName</td>

                                <td>@item.Designation</td>

                                <td>

                                    @if (item.IsActive)
                                    {
                                        <span class="badge bg-success">
                                            Active
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Inactive
                                        </span>
                                    }

                                </td>

                                <td class="text-center">

                                    <a asp-action="Details"
                                       asp-route-id="@item.EmployeeId"
                                       class="btn btn-info btn-sm text-white">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@item.EmployeeId"
                                       class="btn btn-warning btn-sm">

                                        <i class="bi bi-pencil"></i>

                                    </a>

                                    <button type="button"
                                            class="btn btn-danger btn-sm delete-btn"
                                            data-id="@item.EmployeeId"
                                            data-name="@item.FirstName @item.LastName">

                                        <i class="bi bi-trash"></i>

                                    </button>

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7" class="text-center py-5">

                                <i class="bi bi-people display-4 text-secondary"></i>

                                <h5 class="mt-3">
                                    No Employees Found
                                </h5>

                                <p class="text-muted">
                                    Click "Add Employee" to create your first employee.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function() {

            $.fn.dataTable.ext.errMode = 'none';

            var table = $('#employeeTable').DataTable({

                responsive: true,

                autoWidth: false,

                pageLength: 10,

                lengthMenu: [5, 10, 25, 50],

                dom: 'Bfrtip',

                buttons: [

                    {
                        extend: 'copy',
                        className: 'btn btn-secondary'
                    },

                    {
                        extend: 'excel',
                        className: 'btn btn-success'
                    },

                    {
                        extend: 'csv',
                        className: 'btn btn-primary'
                    },

                    {
                        extend: 'pdf',
                        className: 'btn btn-danger'
                    },

                    {
                        extend: 'print',
                        className: 'btn btn-dark'
                    }

                ],

                columnDefs: [

                    { orderable: false, targets: -1 }

                ],

                language: {

                    search: "Search Employee:",

                    lengthMenu: "Show _MENU_ employees",

                    info: "Showing _START_ to _END_ of _TOTAL_ employees",

                    zeroRecords: "No employees found",

                    infoEmpty: "No records available"

                },

                initComplete: function() {

                    console.log('DataTable initialized successfully');

                }

            });

            $(".delete-btn").click(function() {

                let button = $(this);

                let id = button.data("id");

                let name = button.data("name");

                Swal.fire({

                    title: "Delete Employee?",

                    text: "Are you sure you want to delete '" + name + "'?",

                    icon: "warning",

                    showCancelButton: true,

                    confirmButtonColor: "#dc3545",

                    cancelButtonColor: "#6c757d",

                    confirmButtonText: "Yes, Delete"

                }).then((result) => {

                    if (result.isConfirmed) {

                        $.ajax({

                            url: "/Employee/DeleteAjax",

                            type: "POST",

                            data: { id: id },

                            success: function(response) {

                                if (response.success) {

                                    table
                                        .row(button.parents("tr"))
                                        .remove()
                                        .draw();

                                    Swal.fire({

                                        icon: "success",

                                        title: "Deleted!",

                                        text: response.message,

                                        timer: 1800,

                                        showConfirmButton: false

                                    });

                                }
                                else {

                                    Swal.fire("Error", response.message, "error");

                                }

                            },

                            error: function() {

                                Swal.fire(

                                    "Error",

                                    "Unable to delete employee.",

                                    "error"

                                );

                            }

                        });

                    }

                });

            });

        });

    </script>

}