@model EmployeeLeaveManagement.Models.Employee

@{
    ViewData["Title"] = "Delete Employee";
}

<div class="card shadow border-danger">

    <div class="card-header bg-danger text-white">

        <h3>

            <i class="bi bi-trash-fill"></i>

            Delete Employee

        </h3>

    </div>

    <div class="card-body">

        <div class="alert alert-warning">

            <h5>

                Are you sure you want to delete this employee?

            </h5>

        </div>

        <table class="table">

            <tr>
                <th>Name</th>
                <td>@Model.FirstName @Model.LastName</td>
            </tr>

            <tr>
                <th>Email</th>
                <td>@Model.Email</td>
            </tr>

            <tr>
                <th>Department</th>
                <td>@Model.Department?.DepartmentName</td>
            </tr>

            <tr>
                <th>Designation</th>
                <td>@Model.Designation</td>
            </tr>

        </table>

        <form asp-action="Delete">

            <input type="hidden"
                   asp-for="EmployeeId" />

            <button class="btn btn-danger">

                <i class="bi bi-trash"></i>

                Delete Employee

            </button>

            <a asp-action="Index"
               class="btn btn-secondary">

                Cancel

            </a>

        </form>

    </div>

</div>