@model EmployeeLeaveManagement.Models.Department

@{
    ViewData["Title"] = "Add Department";
}

<div class="container-fluid">

    <div class="card shadow-sm">

        <div class="card-header bg-primary text-white">
            <h4 class="mb-0">
                <i class="bi bi-building-add"></i>
                Add New Department
            </h4>
        </div>

        <div class="card-body">

            <form asp-action="Create">

                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-3">
                    <label asp-for="DepartmentName" class="form-label fw-semibold"></label>

                    <input asp-for="DepartmentName"
                           class="form-control"
                           placeholder="Enter Department Name" />

                    <span asp-validation-for="DepartmentName" class="text-danger"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label fw-semibold"></label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4"
                              placeholder="Department Description"></textarea>

                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="CreatedDate" class="form-label fw-semibold"></label>

                    <input asp-for="CreatedDate"
                           type="date"
                           class="form-control"
                           readonly />

                    <span asp-validation-for="CreatedDate" class="text-danger"></span>
                </div>

                <button type="submit" class="btn btn-success px-4">
                    <i class="bi bi-floppy"></i> Save
                </button>

                <a asp-action="Index" class="btn btn-outline-secondary px-4">
                    <i class="bi bi-arrow-left"></i> Back
                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}