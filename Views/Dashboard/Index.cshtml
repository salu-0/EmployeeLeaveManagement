@model EmployeeLeaveManagement.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    var greeting = DateTime.Now.Hour < 12 ? "Good Morning" : DateTime.Now.Hour < 18 ? "Good Afternoon" : "Good Evening";
}

<!-- Welcome Message Section -->
<div class="alert alert-info border-0 shadow-sm mb-4" role="alert">
    <div class="d-flex align-items-center">
        <div class="flex-grow-1">
            <h4 class="mb-2">
                <i class="bi bi-hand-thumbs-up"></i>
                @greeting, @(User.FindFirst("http://schemas.xmlsoap.org/ws/2005/05/identity/claims/givenname")?.Value ?? "Admin")
            </h4>
            <p class="mb-1 text-muted">Welcome back! Here's today's leave summary.</p>
            <small class="text-muted">
                <i class="bi bi-calendar-event"></i>
                @DateTime.Now.ToString("dddd, MMMM d, yyyy")
            </small>
        </div>
        <div class="ms-3">
            <i class="bi bi-emoji-smile" style="font-size: 2.5rem; opacity: 0.3;"></i>
        </div>
    </div>
</div>

<h2 class="mb-4 fw-bold">

    Dashboard

</h2>

<div class="row">

    <div class="col-lg-3 col-md-6 mb-4">

        <div class="card border-0 shadow-lg rounded-4 dashboard-card bg-primary text-white">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <p class="text-white-50 mb-1">
                            Total Employees
                        </p>

                        <h2 class="fw-bold mb-3">
                            <span id="employeeCount">
                                @Model.TotalEmployees
                            </span>
                        </h2>

                        <small>
                            <i class="bi bi-arrow-up"></i>
                            Employee Records
                        </small>

                    </div>

                    <div class="icon-circle">

                        <i class="bi bi-people-fill"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6 mb-4">

        <div class="card border-0 shadow-lg rounded-4 dashboard-card bg-success text-white">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <p class="text-white-50 mb-1">
                            Total Departments
                        </p>

                        <h2 class="fw-bold mb-3">
                            <span id="departmentCount">
                                @Model.TotalDepartments
                            </span>
                        </h2>

                        <small>

                            <i class="bi bi-building"></i>

                            Department Records

                        </small>

                    </div>

                    <div class="icon-circle">

                        <i class="bi bi-buildings-fill"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6 mb-4">

        <div class="card border-0 shadow-lg rounded-4 dashboard-card bg-warning">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <p class="text-dark mb-1">
                            Leave Types
                        </p>

                        <h2 class="fw-bold mb-3">
                            <span id="leaveTypeCount">
                                @Model.TotalLeaveTypes
                            </span>
                        </h2>

                        <small>

                            <i class="bi bi-calendar-check"></i>

                            Leave Categories

                        </small>

                    </div>

                    <div class="icon-circle bg-light">

                        <i class="bi bi-calendar2-check-fill text-warning"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

    <div class="col-lg-3 col-md-6 mb-4">

        <div class="card border-0 shadow-lg rounded-4 dashboard-card bg-danger text-white">

            <div class="card-body">

                <div class="d-flex justify-content-between align-items-start">

                    <div>

                        <p class="text-white-50 mb-1">
                            Pending Requests
                        </p>

                        <h2 class="fw-bold mb-3">
                            <span id="pendingCount">
                                @Model.PendingLeaveRequests
                            </span>
                        </h2>

                        <small>

                            <i class="bi bi-hourglass-split"></i>

                            Waiting Approval

                        </small>

                    </div>

                    <div class="icon-circle">

                        <i class="bi bi-clock-history"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>

</div>

<div class="row">

    <div class="col-md-8">

        <div class="card shadow">

            <div class="card-header">

                Employee by Department

            </div>

            <div class="card-body">

                <div style="height:350px;">
                    <canvas id="departmentChart"></canvas>
                </div>

            </div>

        </div>

    </div>

    <div class="col-md-4">

        <div class="card shadow">

            <div class="card-header">

                Project Status

            </div>

            <div class="card-body">

                <ul class="list-group">

                    <li class="list-group-item">

                        ✅ Departments Module

                    </li>

                    <li class="list-group-item">

                        ✅ Employees Module

                    </li>

                    <li class="list-group-item">

                        ⏳ Leave Types

                    </li>

                    <li class="list-group-item">

                        ⏳ Leave Requests

                                     </ul>

                                 </div>

                             </div>

                               </div>

                           </div>

                         <div class="row mt-4">

                             <div class="col-lg-12">

                                 <div class="card shadow border-0 rounded-4">

                                     <div class="card-header bg-white">

                                         <h5 class="mb-0">

                                             <i class="bi bi-people-fill text-primary"></i>

                                             Recent Employees

                                         </h5>

                                     </div>

                                     <div class="card-body p-0">

                                         <table class="table table-hover mb-0">

                                             <thead class="table-light">

                                                 <tr>

                                                     <th>Name</th>

                                                     <th>Department</th>

                                                     <th>Designation</th>

                                                     <th>Joining Date</th>

                                                 </tr>

                                             </thead>

                                             <tbody>

                                                 @foreach (var emp in Model.RecentEmployees)
                                                 {
                                                     <tr>

                                                         <td>

                                                             @emp.FirstName @emp.LastName

                                                         </td>

                                                         <td>

                                                             @emp.Department?.DepartmentName

                                                         </td>

                                                         <td>

                                                             @emp.Designation

                                                         </td>

                                                         <td>

                                                             @emp.JoiningDate.ToString("dd MMM yyyy")

                                                         </td>

                                                     </tr>
                                                 }

                                             </tbody>

                                         </table>

                                     </div>

                                 </div>

                             </div>

                         </div>

                             @section Scripts{

                    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

                    <script>

                    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.DepartmentChart.Select(x => x.DepartmentName)));

                    const values = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                        Model.DepartmentChart.Select(x => x.EmployeeCount)));

                    const ctx = document.getElementById('departmentChart');

                    new Chart(ctx, {

                        type: 'bar',

                        data: {

                            labels: labels,

                            datasets: [{

                                label: 'Employees',

                                data: values,

                                backgroundColor: [
                                    '#0d6efd',
                                    '#198754',
                                    '#ffc107',
                                    '#dc3545',
                                    '#6610f2',
                                    '#20c997'
                                ],

                                borderRadius: 8,

                                borderSkipped: false

                            }]

                        },

                        options: {

                            responsive: true,

                            maintainAspectRatio: false,

                            plugins: {

                                legend: {

                                    display: false

                                },

                                title: {

                                    display: true,

                                    text: 'Employees by Department'

                                }

                            },

                            scales: {

                                y: {

                                    beginAtZero: true,

                                    ticks: {

                                        precision: 0,

                                        stepSize: 1

                                    },

                                    grid: {

                                        color: '#f1f1f1'

                                    }

                                },

                                x: {

                                    grid: {

                                        display: false

                                    }

                                }

                            }

                        }

                    });

                    new countUp.CountUp('employeeCount',
                        @Model.TotalEmployees).start();

                    new countUp.CountUp('departmentCount',
                        @Model.TotalDepartments).start();

                    new countUp.CountUp('leaveTypeCount',
                        @Model.TotalLeaveTypes).start();

                    new countUp.CountUp('pendingCount',
                        @Model.PendingLeaveRequests).start();

                    </script>

                    }

