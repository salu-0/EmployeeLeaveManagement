@model IEnumerable<EmployeeLeaveManagement.Models.LeaveRequest>

@{
    ViewData["Title"] = "My Leave Requests";
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">

        <h3 class="mb-0">
            <i class="bi bi-calendar-check"></i>
            My Leave Requests
        </h3>

        <a asp-action="Create" class="btn btn-light">
            <i class="bi bi-plus-circle"></i>
            Apply Leave
        </a>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table id="myLeaveTable" class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Total Days</th>
                        <th>Status</th>
                        <th>Applied On</th>
                        <th class="text-center">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    @item.LeaveType?.LeaveName
                                </td>

                                <td>
                                    @item.StartDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @item.EndDate.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    @item.TotalDays
                                </td>

                                <td>

                                    @if (item.Status == "Pending")
                                    {
                                        <span class="badge bg-warning text-dark">
                                            Pending
                                        </span>
                                    }
                                    else if (item.Status == "Approved")
                                    {
                                        <span class="badge bg-success">
                                            Approved
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-danger">
                                            Rejected
                                        </span>
                                    }

                                </td>

                                <td>
                                    @item.AppliedDate.ToString("dd MMM yyyy")
                                </td>

                                <td class="text-center">

                                    <a asp-action="Details"
                                       asp-route-id="@item.LeaveRequestId"
                                       class="btn btn-info btn-sm text-white">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                    @if (item.Status == "Pending")
                                    {
                                        <a asp-action="Edit"
                                           asp-route-id="@item.LeaveRequestId"
                                           class="btn btn-warning btn-sm">

                                            <i class="bi bi-pencil-square"></i>

                                        </a>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7" class="text-center py-5">

                                <i class="bi bi-calendar-x display-4 text-secondary"></i>

                                <h5 class="mt-3">
                                    No Leave Requests Found
                                </h5>

                                <p class="text-muted">
                                    You haven't applied for any leave yet.
                                </p>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function() {

            @if (Model.Any())
            {
                @:$('#myLeaveTable').DataTable({
                    @:responsive: true,
                    @:pageLength: 10,
                    @:lengthMenu: [5, 10, 25, 50]
                @:});
            }

        });

    </script>

}