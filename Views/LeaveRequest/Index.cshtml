@model IEnumerable<EmployeeLeaveManagement.Models.LeaveRequest>

@{
    ViewData["Title"] = "Leave Requests";
}

<div class="card shadow-sm border-0">

    <div class="card-header bg-white d-flex justify-content-between align-items-center">

        <div>
            <h3 class="fw-bold mb-0">
                <i class="bi bi-file-earmark-text-fill text-primary"></i>
                Leave Requests
            </h3>

            <small class="text-muted">
                Manage employee leave requests
            </small>
        </div>

        <div>

            @if (User.IsInRole("Employee"))
            {
                <a asp-action="MyLeaves"
                   class="btn btn-outline-primary me-2">
                    <i class="bi bi-list-check"></i>
                    My Leaves
                </a>
            }

            <a asp-action="Create"
               class="btn btn-primary">
                <i class="bi bi-plus-circle"></i>
                Apply Leave
            </a>

        </div>

    </div>

    <div class="card-body">

        <div class="table-responsive">

            <table id="leaveRequestTable"
                   class="table table-hover align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Employee</th>
                        <th>Leave Type</th>
                        <th>Start Date</th>
                        <th>End Date</th>
                        <th>Total Days</th>
                        <th>Status</th>
                        <th>Applied On</th>
                        <th class="text-center">Actions</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                @item.Employee?.FirstName @item.Employee?.LastName
                            </td>

                            <td>
                                @item.LeaveType?.LeaveName
                            </td>

                            <td>
                                @item.StartDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @item.EndDate.ToString("dd MMM yyyy")
                            </td>

                            <td>
                                @item.TotalDays
                            </td>

                            <td>

                                @if (item.Status == "Pending")
                                {
                                    <span class="badge bg-warning text-dark">
                                        Pending
                                    </span>
                                }
                                else if (item.Status == "Approved")
                                {
                                    <span class="badge bg-success">
                                        Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger">
                                        Rejected
                                    </span>
                                }

                            </td>

                            <td>
                                @item.AppliedDate.ToString("dd MMM yyyy")
                            </td>

                            <td class="text-center">

                                <a asp-action="Details"
                                   asp-route-id="@item.LeaveRequestId"
                                   class="btn btn-info btn-sm text-white">
                                    <i class="bi bi-eye"></i>
                                </a>

                                @if (User.IsInRole("Admin") && item.Status == "Pending")
                                {
                                    <form asp-action="Approve"
                                          asp-route-id="@item.LeaveRequestId"
                                          method="post"
                                          class="d-inline">

                                        <button class="btn btn-success btn-sm">
                                            <i class="bi bi-check-lg"></i>
                                        </button>

                                    </form>

                                    <form asp-action="Reject"
                                          asp-route-id="@item.LeaveRequestId"
                                          method="post"
                                          class="d-inline">

                                        <button class="btn btn-danger btn-sm">
                                            <i class="bi bi-x-lg"></i>
                                        </button>

                                    </form>
                                }

                                @if (User.IsInRole("Admin"))
                                {
                                    <button class="btn btn-outline-danger btn-sm delete-btn"
                                            data-id="@item.LeaveRequestId">
                                        <i class="bi bi-trash"></i>
                                    </button>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        $(document).ready(function() {

            var table = $('#leaveRequestTable').DataTable({

                responsive: true,
                pageLength: 10,
                lengthMenu: [5, 10, 25, 50],

                dom: 'Bfrtip',

                buttons: [

                    {
                        extend: 'copy',
                        className: 'btn btn-secondary'
                    },
                    {
                        extend: 'excel',
                        className: 'btn btn-success'
                    },
                    {
                        extend: 'csv',
                        className: 'btn btn-primary'
                    },
                    {
                        extend: 'pdf',
                        className: 'btn btn-danger'
                    },
                    {
                        extend: 'print',
                        className: 'btn btn-dark'
                    }

                ]

            });

            $('.delete-btn').click(function() {

                let button = $(this);
                let id = button.data("id");

                Swal.fire({

                    title: "Delete Leave Request?",
                    text: "This action cannot be undone.",
                    icon: "warning",

                    showCancelButton: true,
                    confirmButtonColor: "#dc3545",
                    cancelButtonColor: "#6c757d",
                    confirmButtonText: "Yes, Delete"

                }).then((result) => {

                    if (result.isConfirmed) {

                        $.ajax({

                            url: '/LeaveRequest/DeleteAjax',
                            type: 'POST',
                            data: { id: id },

                            success: function(response) {

                                if (response.success) {

                                    table
                                        .row(button.parents('tr'))
                                        .remove()
                                        .draw();

                                    toastr.success(response.message);

                                }
                                else {

                                    toastr.error(response.message);

                                }

                            },

                            error: function() {

                                toastr.error("Something went wrong.");

                            }

                        });

                    }

                });

            });

        });

    </script>

}